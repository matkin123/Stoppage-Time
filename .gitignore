# Data: never commit. raw/ is immutable cache; interim/processed are regenerable.
data/raw/**
data/interim/**
data/processed/**
figures/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!figures/.gitkeep

# Exception: checked-in EXTERNAL ground truth (not regenerable pipeline data).
